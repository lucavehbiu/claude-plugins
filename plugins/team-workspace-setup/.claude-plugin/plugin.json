{
  "name": "team-workspace-setup",
  "version": "1.1.0",
  "description": "Complete team workspace setup with 4 skills, 7 MCP servers, and productivity enhancements",
  "author": {
    "name": "Your Team"
  },
  "repository": "https://github.com/lucavehbiu/claude-plugins",
  "license": "MIT",
  "skills": "./skills",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "brave-search": {
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}",
        "BRAVE_TIMEOUT": "30000"
      }
    },
    "postgres": {
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "@modelcontextprotocol/server-postgres",
        "${POSTGRES_CONNECTION_STRING}"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${WORKSPACE_PATH}"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7"
      ],
      "env": {
        "UPSTASH_CONTEXT7_TOKEN": "${UPSTASH_CONTEXT7_TOKEN}"
      }
    },
    "serena": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/mcp-server-serena"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp-server"
      ]
    }
  }
}
